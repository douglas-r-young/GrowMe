# Required
OPENAI_API_KEY=
FEATHERLESS_API_KEY=
APIFY_TOKEN=

# Optional: faster llama-70B providers for research + design_doc.
# If set, takes precedence over Featherless. Cerebras > Groq on speed.
CEREBRAS_API_KEY=
GROQ_API_KEY=

# Optional flags
USE_LIVE_RESEARCH=true
FEATHERLESS_MAX_CONCURRENCY=4
GROWME_SESSION_DIR=.growme_sessions
